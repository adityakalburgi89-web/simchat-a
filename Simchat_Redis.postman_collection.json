            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"general\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/chatapp/chatrooms",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "chatapp", "chatrooms"]
